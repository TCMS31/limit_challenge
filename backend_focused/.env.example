# Copy to .env to override docker compose defaults. All values are optional.

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-facing API URL. Use localhost, not the compose service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
